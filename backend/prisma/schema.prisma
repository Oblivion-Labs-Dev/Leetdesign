// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  firstName           String
  lastName            String
  name                String
  email               String   @unique // personal / recovery email
  workEmail           String   @unique
  alias               String   @unique
  passwordHash        String?
  avatarUrl           String?
  status              String?  // short user status line, e.g. "Shipping Tiny.link"
  mood                String?  // emoji or single-word mood
  githubUrl           String?
  linkedinUrl         String?
  leetcodeUrl         String?
  websiteUrl          String?
  badge               String   @default("intern")
  xp                  Int      @default(0)
  stardust            Int      @default(0) // in-product currency
  firstVisitCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  componentsSeen   ComponentSeen[]
  projectProgress  ProjectProgress[]
  visitDays        VisitDay[]
}

// One row per UTC day the user opened the app. Powers the calendar heatmap.
model VisitDay {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  day    String   // YYYY-MM-DD UTC
  count  Int      @default(1)

  @@unique([userId, day])
  @@index([userId])
}

// Components a user has been introduced to inside a project lesson.
// Library entries gate on having a ComponentSeen row.
model ComponentSeen {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  componentId String
  projectId   String
  seenAt      DateTime @default(now())

  @@unique([userId, componentId])
  @@index([userId])
}

// Per-user progress through a project journey.
// stageIndex points at the current stage in JOURNEYS[projectId].stages.
model ProjectProgress {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  projectId    String
  stageIndex   Int      @default(0)
  status       String   @default("in_progress") // in_progress | completed
  startedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  completedAt  DateTime?

  @@unique([userId, projectId])
  @@index([userId])
}
